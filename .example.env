# MongoDB Atlas connection string used by mcp_server/, backend/, and the
# checkpoint store. Required.
MONGODB_URI=

# Database name for app collections (manuals/inventory/work_orders) and
# LangGraph checkpoints. Optional — defaults to "machine_repair".
MONGODB_DB=

# Credentials for the Atlas cluster referenced in MONGODB_URI, if you
# assemble the URI from these rather than hardcoding it inline.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Anthropic API key, required only when selecting the Claude ("cloud")
# LLM backend at session start; not needed for the default local Ollama
# backend. Read automatically by the anthropic SDK.
ANTHROPIC_API_KEY=
